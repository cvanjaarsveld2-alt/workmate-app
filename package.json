{
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run test && npm run check:field && npm run check:security && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm run lint && npm run build",
    "check:field": "node scripts/field-readiness.mjs",
    "test": "node --test",
    "check:security": "node --test tests/security-readiness.test.mjs",
    "lint": "eslint src public/service-worker.js",
    "format": "prettier --write",
    "test:sim": "node tests/sim/run.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.4",
    "@vitejs/plugin-react": "^6.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^11.11.17",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "playwright": "^1.56.1",
    "postcss": "^8.4.49",
    "prettier": "^3.9.8",
    "tailwindcss": "^3.4.17"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "browserslist": "^4.28.8"
  }
}
